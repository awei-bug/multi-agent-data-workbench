POSTGRES_DB=workbench
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_PORT=5432

BACKEND_PORT=8787
FRONTEND_PORT=8080

WORKSPACE_MODEL_BASE_URL=https://apihub.agnes-ai.com/v1
WORKSPACE_MODEL_NAME=Agnes 2.0 Flash
WORKSPACE_MODEL_TIMEOUT_SECONDS=60
WORKSPACE_LOG_LEVEL=INFO
WORKSPACE_RUN_MIGRATIONS_ON_START=true
WORKSPACE_ENABLE_AUDIT_EVENTS=true
WORKSPACE_RATE_LIMIT_PER_MINUTE=120
WORKSPACE_MAX_REQUEST_BODY_BYTES=10000000
WORKSPACE_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:8080,http://localhost:8080
WORKSPACE_DEFAULT_USER_ID=local-user
WORKSPACE_DEFAULT_TENANT_ID=local-tenant
WORKSPACE_ADMIN_API_KEY=
WORKSPACE_AUTH_SECRET=local-dev-only-change-me
WORKSPACE_AUTH_TOKEN_MINUTES=720
WORKSPACE_AUTH_REQUIRED=false
WORKSPACE_WORKFLOW_ASYNC=true
WORKSPACE_WORKFLOW_STEP_DELAY_MS=0
WORKSPACE_JSON_LOGS=false
WORKSPACE_METRICS_ENABLED=true
WORKSPACE_QUEUE_BACKEND=redis
WORKSPACE_REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
WORKSPACE_ERROR_TRACKING_ENABLED=true
WORKSPACE_SENTRY_DSN=
WORKSPACE_SENTRY_ENVIRONMENT=compose
WORKSPACE_SENTRY_TRACES_SAMPLE_RATE=0
WORKSPACE_ALERT_WEBHOOK_URL=
WORKSPACE_ALERT_MIN_LEVEL=error
WORKSPACE_RATE_LIMIT_BACKEND=redis
WORKSPACE_CREDENTIALS_SECRET=

APIHUB_API_KEY=
VITE_WORKSPACE_API_BASE_URL=

# Storage / security extras
WORKSPACE_ARTIFACT_BACKEND=local
WORKSPACE_ENABLE_HSTS=false
WORKSPACE_PRODUCTION_MODE=false

# OIDC SSO (optional)
WORKSPACE_OIDC_ENABLED=false
WORKSPACE_OIDC_ISSUER=
WORKSPACE_OIDC_CLIENT_ID=
WORKSPACE_OIDC_CLIENT_SECRET=
WORKSPACE_OIDC_REDIRECT_URI=http://127.0.0.1:8787/api/auth/oidc/callback
WORKSPACE_OIDC_SCOPES=openid profile email
WORKSPACE_OIDC_AUTHORIZE_URL=
WORKSPACE_OIDC_TOKEN_URL=
WORKSPACE_OIDC_USERINFO_URL=
