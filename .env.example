# 后端模型配置
AGNES_API_KEY=你的模型密钥
# OPENAI_API_KEY=也可以使用这个变量名
# APIHUB_API_KEY=也可以使用这个变量名

# 后端服务配置
WORKSPACE_API_HOST=127.0.0.1
WORKSPACE_API_PORT=8787
WORKSPACE_DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/workbench
WORKSPACE_MODEL_TIMEOUT_SECONDS=60
WORKSPACE_ENABLE_AUDIT_EVENTS=true
WORKSPACE_MAX_REQUEST_BODY_BYTES=2000000
WORKSPACE_RATE_LIMIT_PER_MINUTE=120
WORKSPACE_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# 前端服务配置
WORKSPACE_WEB_HOST=127.0.0.1
WORKSPACE_WEB_PORT=5174
VITE_WORKSPACE_API_BASE_URL=http://127.0.0.1:8787
