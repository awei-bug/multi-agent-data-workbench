# Production 环境变量模板
# 复制到生产服务器：/opt/workbench-prod/.env

POSTGRES_DB=workbench
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password

# 镜像
IMAGE_PREFIX=ghcr.io/<owner>/<repo>
IMAGE_TAG=v1.0.0

# 对外端口
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443
GRAFANA_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# TLS 证书目录（需包含 fullchain.pem / privkey.pem）
TLS_CERT_DIR=./deploy/certs

# 模型与业务
WORKSPACE_MODEL_BASE_URL=https://apihub.agnes-ai.com/v1
WORKSPACE_MODEL_NAME=Agnes 2.0 Flash
WORKSPACE_MODEL_TIMEOUT_SECONDS=60
WORKSPACE_MODEL_MAX_ATTEMPTS=2
WORKSPACE_MODEL_TOTAL_TIMEOUT_SECONDS=120
WORKSPACE_MODEL_BACKOFF_BASE_SECONDS=0.5
WORKSPACE_MODEL_BACKOFF_MAX_SECONDS=8
WORKSPACE_MODEL_CIRCUIT_FAILURE_THRESHOLD=5
WORKSPACE_MODEL_CIRCUIT_RECOVERY_SECONDS=30
APIHUB_API_KEY=

# 生产安全（强制）
WORKSPACE_ENV=production
WORKSPACE_PRODUCTION_MODE=true
WORKSPACE_ENFORCE_PRODUCTION_SECURITY=true
WORKSPACE_AUTH_REQUIRED=true
WORKSPACE_AUTH_SECRET=replace-with-long-random-string-at-least-24-chars
WORKSPACE_AUTH_TOKEN_MINUTES=30
WORKSPACE_AUTH_REFRESH_DAYS=14
WORKSPACE_ADMIN_API_KEY=replace-with-admin-key-at-least-16-chars
WORKSPACE_CREDENTIALS_SECRET=replace-with-credentials-secret-at-least-24-chars
WORKSPACE_CORS_ORIGINS=https://app.example.com
WORKSPACE_ENABLE_HSTS=true
WORKSPACE_ALLOW_OPEN_REGISTRATION=false
WORKSPACE_ALLOW_SELF_TENANT=false
WORKSPACE_METRICS_PUBLIC=false
WORKSPACE_PASSWORD_COMPLEXITY=true
WORKSPACE_LOGIN_MAX_FAILURES=8
WORKSPACE_LOGIN_LOCKOUT_SECONDS=900

# 队列 / 限流 / 日志
WORKSPACE_QUEUE_BACKEND=redis
WORKSPACE_QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
WORKSPACE_QUEUE_MAX_ATTEMPTS=3
WORKSPACE_REDIS_PASSWORD=replace-with-strong-redis-password
WORKSPACE_REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0
WORKSPACE_RATE_LIMIT_BACKEND=redis
WORKSPACE_RATE_LIMIT_PER_MINUTE=120
WORKSPACE_WORKFLOW_ASYNC=true
WORKSPACE_JSON_LOGS=true
WORKSPACE_METRICS_ENABLED=true
WORKSPACE_LOG_LEVEL=INFO
WORKSPACE_RUN_MIGRATIONS_ON_START=true
WORKSPACE_ENABLE_AUDIT_EVENTS=true

# 对象存储（MinIO/S3）
WORKSPACE_ARTIFACT_BACKEND=s3
WORKSPACE_S3_BUCKET=workbench-artifacts
WORKSPACE_S3_ENDPOINT_URL=http://minio:9000
WORKSPACE_S3_ACCESS_KEY=replace-minio-access-key
WORKSPACE_S3_SECRET_KEY=replace-minio-secret-key
WORKSPACE_S3_REGION=us-east-1
WORKSPACE_S3_PREFIX=workspace-artifacts

# 错误追踪
WORKSPACE_ERROR_TRACKING_ENABLED=true
WORKSPACE_SENTRY_DSN=
WORKSPACE_SENTRY_ENVIRONMENT=production
WORKSPACE_SENTRY_TRACES_SAMPLE_RATE=0.1
WORKSPACE_ALERT_WEBHOOK_URL=
WORKSPACE_ALERT_MIN_LEVEL=error

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-grafana-password

# OIDC SSO (optional)
WORKSPACE_OIDC_ENABLED=false
WORKSPACE_OIDC_ISSUER=
WORKSPACE_OIDC_CLIENT_ID=
WORKSPACE_OIDC_CLIENT_SECRET=
WORKSPACE_OIDC_REDIRECT_URI=http://127.0.0.1:8787/api/auth/oidc/callback
WORKSPACE_OIDC_SCOPES=openid profile email
WORKSPACE_OIDC_AUTHORIZE_URL=
WORKSPACE_OIDC_TOKEN_URL=
WORKSPACE_OIDC_USERINFO_URL=

# Compliance: export watermark / sensitive masking / retention (days, 0=keep forever)
WORKSPACE_EXPORT_WATERMARK=true
WORKSPACE_EXPORT_MASK_SENSITIVE=true
WORKSPACE_RETENTION_HISTORY_DAYS=90
WORKSPACE_RETENTION_DATASET_DAYS=180
WORKSPACE_RETENTION_ARTIFACT_DAYS=180
WORKSPACE_RETENTION_AUDIT_DAYS=365
