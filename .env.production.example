# Production 环境变量模板
# 复制到生产服务器：/opt/workbench-prod/.env

POSTGRES_DB=workbench
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_PORT=5432
REDIS_PORT=6379

BACKEND_PORT=8787
FRONTEND_PORT=8080

# 镜像（部署脚本会覆盖 IMAGE_TAG）
IMAGE_PREFIX=ghcr.io/<owner>/<repo>
IMAGE_TAG=v1.0.0

# 模型与业务
WORKSPACE_MODEL_BASE_URL=https://apihub.agnes-ai.com/v1
WORKSPACE_MODEL_NAME=Agnes 2.0 Flash
WORKSPACE_MODEL_TIMEOUT_SECONDS=60
APIHUB_API_KEY=

# 安全（生产强制）
WORKSPACE_AUTH_SECRET=replace-with-long-random-string
WORKSPACE_AUTH_REQUIRED=true
WORKSPACE_ADMIN_API_KEY=replace-with-admin-key
WORKSPACE_CORS_ORIGINS=https://app.example.com
WORKSPACE_CREDENTIALS_SECRET=replace-with-credentials-secret

# 队列与可观测
WORKSPACE_QUEUE_BACKEND=redis
WORKSPACE_REDIS_URL=redis://redis:6379/0
WORKSPACE_RATE_LIMIT_BACKEND=redis
WORKSPACE_RATE_LIMIT_PER_MINUTE=120
WORKSPACE_WORKFLOW_ASYNC=true
WORKSPACE_JSON_LOGS=true
WORKSPACE_METRICS_ENABLED=true
WORKSPACE_LOG_LEVEL=INFO

# 错误追踪
WORKSPACE_ERROR_TRACKING_ENABLED=true
WORKSPACE_SENTRY_DSN=
WORKSPACE_SENTRY_ENVIRONMENT=production
WORKSPACE_SENTRY_TRACES_SAMPLE_RATE=0.1
WORKSPACE_ALERT_WEBHOOK_URL=
WORKSPACE_ALERT_MIN_LEVEL=error

# 默认作用域（登录后会被 JWT 覆盖）
WORKSPACE_DEFAULT_USER_ID=local-user
WORKSPACE_DEFAULT_TENANT_ID=local-tenant
WORKSPACE_RUN_MIGRATIONS_ON_START=true
WORKSPACE_ENABLE_AUDIT_EVENTS=true
